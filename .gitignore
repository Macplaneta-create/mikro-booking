# Dependencies
/vendor/
/admin/node_modules/
/admin/dist/

# Build artifacts (kept in assets/admin/)
/assets/admin/*
!/assets/admin/.gitkeep

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# WordPress
wp-config.php

# Deployment
deploy.config
*.zip
.deployignore

# Debug/Test files (should not be in production)
debug-*.php
test-*.php
.phpunit.result.cache

# Local release artifacts
/releases/
